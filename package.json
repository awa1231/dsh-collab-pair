{
  "name": "dsh-collab-pair",
  "version": "1.4.0",
  "description": "For large projects: link a project-manager conversation with local or remote workers across devices (temporary or permanent), dispatch each round from the manager, relay results automatically, pre-write a stage queue that advances when a stage completes, and manage it all from a visual Settings page and a conversation context menu. Includes a relay hub and a free ntfy.sh transport for cross-device runs.",
  "type": "module",
  "license": "MIT",
  "author": "awa1231",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awa1231/dsh-collab-pair.git"
  },
  "homepage": "https://www.npmjs.com/package/dsh-collab-pair",
  "bugs": {
    "url": "https://github.com/awa1231/dsh-collab-pair/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "collaboration",
    "multi-agent",
    "project-manager"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "hub.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
